{
  "version": "1.0",
  "description": "Skill activation triggers for Language Operator project",
  "skills": {
    "kubernetes-operator-patterns": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Go controller patterns, CRDs, RBAC, and Kubernetes operator development",
      "promptTriggers": {
        "keywords": [
          "controller",
          "CRD",
          "Custom Resource Definition",
          "RBAC",
          "operator",
          "reconcile",
          "kubebuilder",
          "controller-runtime",
          "Kubernetes API",
          "client-go",
          "ginkgo",
          "gomega",
          "integration test",
          "manifests",
          "controller-gen"
        ],
        "intentPatterns": [
          "(create|add|implement|build).*?(controller|CRD|operator)",
          "(how to|best practice).*?(reconcile|controller|RBAC)",
          "(fix|debug|handle).*?(controller|reconciliation|operator)",
          "(generate|create|update).*?(manifests|CRD|RBAC)",
          "(test|testing).*?(controller|operator|integration)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "src/controllers/**/*.go",
          "src/api/**/*.go",
          "src/config/**/*.yaml",
          "src/config/**/*.yml",
          "**/*_test.go",
          "chart/**/*.yaml",
          "chart/**/*.yml"
        ],
        "pathExclusions": [
          "**/vendor/**",
          "**/node_modules/**",
          "**/.git/**"
        ],
        "contentPatterns": [
          "import.*controller-runtime",
          "import.*client-go",
          "\\+kubebuilder:",
          "func.*Reconcile",
          "client\\.Client",
          "ctrl\\.Request",
          "ctrl\\.Result",
          "ginkgo\\.",
          "gomega\\.",
          "Describe\\(",
          "It\\(",
          "Expect\\("
        ]
      }
    }
  }
}