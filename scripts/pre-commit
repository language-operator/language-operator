#!/bin/bash
# Pre-commit hook for language-operator
# Ensures code quality standards are met before committing

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Change to the src directory where Go code resides
cd "$(git rev-parse --show-toplevel)/src" 2>/dev/null || cd "$(git rev-parse --show-toplevel)"

# Get all staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    # No Go files staged, nothing to check
    exit 0
fi

echo -e "${YELLOW}Running pre-commit checks on staged Go files...${NC}"

# Check if we're in the right directory with go.mod
if [ ! -f "go.mod" ]; then
    echo -e "${RED}Error: go.mod not found. Please ensure you're in the correct directory.${NC}"
    exit 1
fi

# Convert file paths to be relative to current directory
RELATIVE_FILES=""
for file in $STAGED_GO_FILES; do
    if [ -f "$file" ]; then
        RELATIVE_FILES="$RELATIVE_FILES $file"
    elif [ -f "../$file" ]; then
        # Handle case where file is in parent directory
        RELATIVE_FILES="$RELATIVE_FILES ../$file"
    fi
done

if [ -z "$RELATIVE_FILES" ]; then
    # No Go files found in current scope
    exit 0
fi

# Track if any check fails
FAILED=0

# 1. Check go fmt
echo -e "${YELLOW}Checking go fmt...${NC}"
UNFMT_FILES=$(gofmt -l $RELATIVE_FILES 2>/dev/null || true)
if [ -n "$UNFMT_FILES" ]; then
    echo -e "${RED}The following files are not properly formatted:${NC}"
    echo "$UNFMT_FILES"
    echo -e "${YELLOW}Run 'go fmt ./...' or 'make fmt' to fix formatting issues${NC}"
    FAILED=1
fi

# 2. Run go vet
echo -e "${YELLOW}Running go vet...${NC}"
if ! go vet ./... 2>&1; then
    echo -e "${RED}go vet found issues${NC}"
    echo -e "${YELLOW}Fix the issues reported by 'go vet ./...' or 'make vet'${NC}"
    FAILED=1
fi

# 3. Get unique packages from staged files
PACKAGES=""
for file in $RELATIVE_FILES; do
    # Get the package directory
    PKG_DIR=$(dirname "$file")
    # Remove leading ./ if present
    PKG_DIR="${PKG_DIR#./}"
    # Add to packages if not already there
    if [[ ! " $PACKAGES " =~ " $PKG_DIR " ]]; then
        PACKAGES="$PACKAGES $PKG_DIR"
    fi
done

# 4. Run tests for affected packages
if [ -n "$PACKAGES" ]; then
    echo -e "${YELLOW}Running tests for affected packages...${NC}"
    for pkg in $PACKAGES; do
        # Skip directories that don't exist or don't have Go files
        if [ ! -d "$pkg" ] || [ -z "$(find "$pkg" -maxdepth 1 -name '*.go' 2>/dev/null)" ]; then
            continue
        fi
        
        # Check if package has test files
        if ls "$pkg"/*_test.go >/dev/null 2>&1; then
            echo "Testing package: ./$pkg"
            if ! go test -v -race "./$pkg" 2>&1; then
                echo -e "${RED}Tests failed in package: $pkg${NC}"
                FAILED=1
            fi
        fi
    done
fi

# 5. Check for generated files that need updating
echo -e "${YELLOW}Checking if generated files are up-to-date...${NC}"
if make generate >/dev/null 2>&1; then
    # Check if any generated files were modified
    if git diff --exit-code --name-only | grep -E '\.(deepcopy|pb)\.go$|zz_generated\.' >/dev/null 2>&1; then
        echo -e "${RED}Generated files are out of date${NC}"
        echo -e "${YELLOW}Run 'make generate' to update generated files${NC}"
        FAILED=1
    fi
fi

# Final result
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ All pre-commit checks passed${NC}"
    exit 0
else
    echo -e "${RED}✗ Pre-commit checks failed${NC}"
    echo -e "${YELLOW}Fix the issues above and try committing again${NC}"
    exit 1
fi